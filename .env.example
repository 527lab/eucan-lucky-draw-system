# 複製為 .env 後填入實際值。.env 不進版控；此檔只放鍵名與說明，不放任何真實值。

# development | test | production（test 時允許缺值）
APP_ENV=development
# 產生連結用，例如 https://draw.example.com
APP_BASE_URL=
# LINE Messaging API：驗證 webhook 簽章
LINE_CHANNEL_SECRET=
# LINE Messaging API：呼叫 API 的 access token
LINE_CHANNEL_ACCESS_TOKEN=
# Postgres 連線字串（compose 內部網路）
DATABASE_URL=
# 照片 volume 掛載路徑，例如 /data/photos
PHOTO_STORAGE_DIR=
# cookie 簽章用隨機字串
SESSION_SECRET=
# 保護排程端點用隨機字串
CRON_SECRET=
# Cloudflare Tunnel token（只給 cloudflared 容器使用，app 不讀取）
TUNNEL_TOKEN=
# 後台登入驗證來源：leave-api（預設）| mock（僅開發／測試）
ADMIN_AUTH_SOURCE=mock
# 請假系統整合 API（員工編號查證、後台登入驗證）；ADMIN_AUTH_SOURCE=leave-api 時必填
LEAVE_API_BASE_URL=
LEAVE_API_TOKEN=
# （選用）緊急備援密碼雜湊；未設定即停用
ADMIN_PASSWORD_HASH=
